# Copy to backend/.env (or export) for local development. Never commit real values.

APP_ENV=development
DATABASE_URL=sqlite:///./var/careerpilot.db
# DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5433/careerpilot   # with `docker compose up db`

# Required in production: long random values.
JWT_SECRET=
SECRET_ENCRYPTION_KEY=
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
CORS_ORIGINS=
PUBLIC_WEB_URL=http://localhost:5173

# Language model (optional). none | gemini | openai_compatible
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Optional server-wide read-only GitHub token (users can also add their own in Settings).
GITHUB_TOKEN=

# Local development only: hosts allowed despite the private-network block (e.g. 127.0.0.1 for test fixtures).
FETCH_ALLOW_PRIVATE_HOSTS=

WORKER_ENABLED=true
WORKER_THREADS=2
