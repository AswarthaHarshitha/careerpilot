# Copy to backend/.env for local development. Never commit real values: .env files are git-ignored.
# Every variable here is read by the API only. The web app gets no secrets.

APP_ENV=development

# AI (all optional: without a provider, every step uses deterministic processing)
GEMINI_API_KEY=
GEMINI_MODEL=              # empty: the current Flash model from Google's model list
OPENROUTER_API_KEY=
OPENROUTER_MODEL=          # empty: OpenRouter's free-model router or a currently listed free model
# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=              # empty: the first model Ollama has installed
AI_PROVIDER_ORDER=gemini,openrouter,ollama

# GitHub (optional; raises the API rate limit and allows private repositories)
GITHUB_TOKEN=

# Database: SQLite locally, PostgreSQL in production (Supabase, Neon or any other)
DATABASE_URL=sqlite:///./var/careerpilot.db
# DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5433/careerpilot   # with `docker compose up db`

# Authentication (production: long random values; see SETUP.md)
SECRET_KEY=
SECRET_ENCRYPTION_KEY=     # Fernet key that encrypts stored API keys and tokens
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
CORS_ORIGINS=
PUBLIC_WEB_URL=http://localhost:5173

# Frontend: only where the development server proxies /api (not a secret; production uses the host's rewrite)
VITE_API_URL=http://127.0.0.1:8010

# Local development only: hosts allowed despite the private-network block (e.g. 127.0.0.1 for test fixtures).
FETCH_ALLOW_PRIVATE_HOSTS=

WORKER_ENABLED=true
WORKER_THREADS=2
